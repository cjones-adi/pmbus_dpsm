@startuml PMBus_Detection_Sequence

title Device Detection and Instantiation Sequence

actor Application
participant LT_PMBusDetect
participant LT_PMBus
participant LT_SMBus
participant "Device Factory"
participant LT_PMBusDevice

Application -> LT_PMBusDetect: new LT_PMBusDetect(pmbus)
Application -> LT_PMBusDetect: detect()

LT_PMBusDetect -> LT_SMBus: probe(0)
LT_SMBus --> LT_PMBusDetect: addresses[]

loop for each address in addresses[]
    LT_PMBusDetect -> LT_PMBus: getMfrSpecialId(address)
    LT_PMBus -> LT_SMBus: readWord(address, MFR_SPECIAL_ID)
    LT_SMBus --> LT_PMBus: device_id
    LT_PMBus --> LT_PMBusDetect: device_id

    LT_PMBusDetect -> "Device Factory": tryDetectDevice(pmbus, address)

    alt device_id == 0x4020
        "Device Factory" -> LT_PMBusDeviceLTC3880: detect(pmbus, address)
        LT_PMBusDeviceLTC3880 -> LT_PMBusDeviceLTC3880: new LT_PMBusDeviceLTC3880()
        LT_PMBusDeviceLTC3880 -> LT_PMBusDevice: probeSpeed()
        LT_PMBusDeviceLTC3880 --> "Device Factory": device_instance
    else device_id == 0x0110
        "Device Factory" -> LT_PMBusDeviceLTC2978: detect(pmbus, address)
        LT_PMBusDeviceLTC2978 -> LT_PMBusDeviceLTC2978: new LT_PMBusDeviceLTC2978()
        LT_PMBusDeviceLTC2978 -> LT_PMBusDevice: probeSpeed()
        LT_PMBusDeviceLTC2978 --> "Device Factory": device_instance
    else device_id == unknown
        "Device Factory" --> LT_PMBusDetect: NULL
    end

    "Device Factory" --> LT_PMBusDetect: device_instance
    LT_PMBusDetect -> LT_PMBusDetect: devices_[deviceCnt_++] = device
end

LT_PMBusDetect --> Application: detection complete
Application -> LT_PMBusDetect: getDevices()
LT_PMBusDetect --> Application: devices[]

note right of "Device Factory" : Factory Pattern:\nDevice creation based on\nhardware ID detection\n\nSupports 27 device types\nAutomatic capability detection

note right of LT_PMBusDevice : Template Method:\nCommon initialization\nSpeed probing\nCapability setup

@enduml
