PMBusApp --> NVM : "creates/manages"
NVM --> DataPipeline : "uses pipeline"
NVM --> RecordProcessor : "processes records"
DataPipeline --> HexFileParser : "parsing functions"
RecordProcessor --> NVMDataHelpers : "NVM operations"
RecordProcessor --> "t_RECORD_PMBUS_WRITE_BYTE" : "processes"
RecordProcessor --> "t_RECORD_PMBUS_WRITE_WORD" : "processes"
RecordProcessor --> "t_RECORD_NVM_DATA" : "processes"
RecordProcessor --> "t_RECORD_PMBUS_READ_BYTE_EXPECT" : "processes"
RecordProcessor --> "t_RECORD_DELAY_MS" : "processes"
NVMDataHelpers --> nvramNode_t : "manages linked list"
NVMDataHelpers --> LT_SMBusNoPec : "communication"
NVMDataHelpers --> LT_SMBusPec : "communication"
RecordProcessor --> LT_PMBus : "hardware access"

' Inheritance
RecordHeader <|-- "t_RECORD_PMBUS_WRITE_BYTE"
RecordHeader <|-- "t_RECORD_PMBUS_WRITE_WORD"  
RecordHeader <|-- "t_RECORD_NVM_DATA"
RecordHeader <|-- "t_RECORD_PMBUS_READ_BYTE_EXPECT"
RecordHeader <|-- "t_RECORD_DELAY_MS"

' Global objects
NVM --> LT_PMBus : "pmbus__"
NVM --> LT_SMBusNoPec : "smbusNoPec__"
NVM --> LT_SMBusPec : "smbusPec__"

@enduml

' Sequence diagram for programming flow
@startuml Programming_Sequence
!theme plain
title EEPROM Programming Sequence Flow

actor User
participant PMBusApp  
participant NVM
participant DataPipeline
participant HexFileParser
participant RecordProcessor
participant NVMDataHelpers
participant LT_PMBus
participant "PMBus Device" as Device

User -> PMBusApp : program_nvm(path)
activate PMBusApp

PMBusApp -> NVM : new NVM(pmbus, smbusNoPec, smbusPec)
activate NVM

PMBusApp -> NVM : programWithFileData(path)
NVM -> DataPipeline : readFileData(path)
activate DataPipeline
DataPipeline --> NVM : char* data
deactivate DataPipeline

NVM -> DataPipeline : reset_parse_hex()
NVM -> RecordProcessor : processRecordsOnDemand(get_record)
activate RecordProcessor

loop for each record in hex file
    RecordProcessor -> DataPipeline : get_record()
    activate DataPipeline
    DataPipeline -> HexFileParser : parse_record()
    activate HexFileParser
    HexFileParser -> DataPipeline : get_record_data()
    DataPipeline -> HexFileParser : binary data
    HexFileParser --> DataPipeline : pRecordHeaderLengthAndType
    deactivate HexFileParser
    DataPipeline --> RecordProcessor : record
    deactivate DataPipeline
    
    alt Record Type 0x09 (NVM_DATA)
        RecordProcessor -> NVMDataHelpers : bufferNvmData(record)
        activate NVMDataHelpers
        NVMDataHelpers -> NVMDataHelpers : build linked list
        NVMDataHelpers --> RecordProcessor : success
        deactivate NVMDataHelpers
    else Record Type 0x1E (WRITE_NVM_DATA)  
        RecordProcessor -> NVMDataHelpers : writeNvmData(record)
        activate NVMDataHelpers
        loop for each word in buffer
            NVMDataHelpers -> LT_PMBus : writeWord(address, command, data)
            activate LT_PMBus
            LT_PMBus -> Device : SMBus Write
            Device --> LT_PMBus : ACK
            LT_PMBus -> Device : readByte(0xEF) [busy check]
            Device --> LT_PMBus : status
            LT_PMBus --> NVMDataHelpers : success
            deactivate LT_PMBus
        end
        NVMDataHelpers --> RecordProcessor : success
        deactivate NVMDataHelpers
    else Other record types
        RecordProcessor -> LT_PMBus : appropriate operation
        LT_PMBus -> Device : SMBus operation
        Device --> LT_PMBus : response
        LT_PMBus --> RecordProcessor : success
    end
end

RecordProcessor --> NVM : programming complete
deactivate RecordProcessor

NVM --> PMBusApp : success/failure
deactivate NVM

PMBusApp -> PMBusApp : wait_for_nvm() [4 seconds]
PMBusApp -> User : "Programming Complete"
deactivate PMBusApp

@enduml
